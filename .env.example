# LLM (NVIDIA Nemotron via build.nvidia.com)
NVIDIA_API_KEY=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ig_news_agent

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=

# Telegram (dipakai untuk review bot DAN telegram_preview_publisher)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREVIEW_CHAT_ID=

# App config
POST_SCORE_THRESHOLD_VIRAL=7
POST_SCORE_THRESHOLD_CREDIBILITY=6
MAX_POSTS_PER_DAY=10
REVIEW_MODE=manual

# Publisher mode: mock | telegram_preview | instagram
PUBLISH_MODE=mock

# AI Image Generation
IMAGE_GEN_PROVIDER=mock
STABILITY_API_KEY=